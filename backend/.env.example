# ── Footage Brain – Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# For portable / copy-to-new-PC mode, see .env.portable.example instead.

# --- Application ---
APP_ENV=development            # development | production
APP_HOST=0.0.0.0
APP_PORT=8765
SECRET_KEY=change-me-in-production

# --- Portable mode (optional) ---
# Set DATA_ROOT to a single folder and every storage path (DB, vectors,
# thumbnails, keyframes, model cache, logs) will live under it automatically.
# Individual path overrides below take precedence over DATA_ROOT when set.
# DATA_ROOT=./portable_data

# --- Database ---
DATABASE_URL=sqlite:///./footage_brain.db
# For Postgres (phase 2): postgresql+asyncpg://user:pass@localhost:5432/footage_brain

# --- Storage paths (use forward slashes even on Windows) ---
THUMBNAILS_DIR=./data/thumbnails
KEYFRAMES_DIR=./data/keyframes
CHROMA_DIR=./data/chroma

# --- Model cache (optional) ---
# Overrides HF_HOME so Whisper, CLIP, and sentence-transformers model weights
# download here instead of %USERPROFILE%\.cache\huggingface
# MODEL_CACHE_DIR=./data/models

# --- Transcription ---
# Whisper model size: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu              # cpu | cuda
WHISPER_COMPUTE_TYPE=int8       # int8 | float16 | float32 | int8_float16

# --- Embeddings ---
# Sentence-transformers model for text embeddings
EMBED_MODEL=all-MiniLM-L6-v2

# --- Ingest pipeline ---
# How many worker threads to use for background processing
INGEST_WORKERS=2
# Frame sample interval in seconds for thumbnail/keyframe extraction
FRAME_SAMPLE_INTERVAL=15
# Max concurrent transcription jobs
TRANSCRIBE_WORKERS=1

# --- Supported video extensions (comma-separated) ---
VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.mxf,.r3d,.braw,.wmv,.flv,.webm,.m4v,.ts,.mts,.m2ts,.3gp,.f4v

# --- Logging ---
LOG_LEVEL=INFO
# When set, logs are also written to LOG_DIR/footage_brain.log (rotating 10 MB x 5)
# LOG_DIR=./data/logs
