# ── Footage Brain – Portable Mode Environment ──────────────────────────────
#
# USE THIS FILE when you want everything self-contained under one folder so
# you can copy or move the project to another Windows PC.
#
# HOW TO USE:
#   copy backend\.env.portable.example backend\.env
#   (then edit WHISPER_DEVICE below to match your GPU)
#
# With DATA_ROOT=./portable_data and no individual overrides:
#
#   backend/portable_data/
#   ├── footage_brain.db          ← SQLite database
#   ├── thumbnails/               ← extracted thumbnail JPEGs
#   ├── keyframes/                ← extracted keyframe JPEGs
#   ├── chroma/                   ← Chroma vector DB (semantic search index)
#   ├── models/                   ← HuggingFace model cache (~5 GB)
#   │   ├── hub/                  ← Whisper, CLIP, mxbai-embed weights
#   │   └── sentence-transformers/
#   └── logs/                     ← footage_brain.log (rotating 10 MB × 5)
#
# INDIVIDUAL OVERRIDES:
#   Any path variable set alongside DATA_ROOT wins for that specific path.
#   Example: keep models on a fast drive but everything else in portable_data:
#     DATA_ROOT=./portable_data
#     MODEL_CACHE_DIR=D:/ml_models
#
# ─────────────────────────────────────────────────────────────────────────────

# --- Application ---
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-string

# --- Portable storage root ---
# All unset paths below resolve to subdirectories of this folder.
# Relative to the backend/ working directory.
DATA_ROOT=./portable_data

# --- Database ---
# Auto-derived: ./portable_data/footage_brain.db
# Override example: DATABASE_URL=sqlite:///./portable_data/footage_brain.db

# --- Storage paths ---
# Auto-derived from DATA_ROOT.  Uncomment to override individually:
# THUMBNAILS_DIR=./portable_data/thumbnails
# KEYFRAMES_DIR=./portable_data/keyframes
# CHROMA_DIR=./portable_data/chroma

# --- Model cache ---
# Auto-derived: ./portable_data/models
# This sets HF_HOME, HF_HUB_CACHE, TRANSFORMERS_CACHE, and
# SENTENCE_TRANSFORMERS_HOME so all model weights land here.
# Copy portable_data/models/ to the new machine to skip re-downloading (~5 GB).
# Override example: MODEL_CACHE_DIR=D:/ml_models

# --- Logging ---
LOG_LEVEL=INFO
# Auto-derived: ./portable_data/logs/footage_brain.log
# Override example: LOG_DIR=./portable_data/logs

# --- Transcription ---
# !! EDIT THIS for your GPU !!
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda              # cpu | cuda  ← change to cpu if no NVIDIA GPU
WHISPER_COMPUTE_TYPE=int8_float16  # int8_float16 = best for 6 GB VRAM (GTX 1660 Ti)
                                   # float16     = faster on 8+ GB VRAM cards
                                   # int8        = CPU mode

# --- Embeddings ---
EMBED_MODEL=mixedbread-ai/mxbai-embed-large-v1

# --- Ingest pipeline ---
INGEST_WORKERS=1
FRAME_SAMPLE_INTERVAL=60
TRANSCRIBE_WORKERS=1

# --- Video extensions ---
VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.mxf,.r3d,.braw,.wmv,.flv,.webm,.m4v,.ts,.mts,.m2ts,.3gp,.f4v
